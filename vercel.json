{
  "cleanUrls": true,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "biji/**", "use": "@vercel/static" }
  ],
  "rewrites": [
    {
      "source": "/api/find",
      "destination": "/api/find.js"
    },
    {
      "source": "/api/search",
      "destination": "/api/search.js"
    },
    {
      "source": "/api/suggest",
      "destination": "/api/suggest.js"
    },
    {
      "source": "/api/handshake",
      "destination": "/api/handshake.js"
    },
    {
      "source": "/:path((?!api/|biji/).*)",
      "destination": "/biji/:path"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
