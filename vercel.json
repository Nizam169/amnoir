{
  "cleanUrls": true,
  "builds": [
    { "src": "api/find.js", "use": "@vercel/node" },
    { "src": "biji/**", "use": "@vercel/static" }
  ],
  "rewrites": [
    {
      "source": "/api/find",
      "destination": "/api/find.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
